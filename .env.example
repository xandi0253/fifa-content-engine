# Application
APP_ENV=development
APP_NAME=FIFA Content Engine
LOG_LEVEL=INFO

# AI providers - fill locally, never commit real keys
OPENAI_API_KEY=

# YouTube (Sprint 5) - OAuth 2.0 installed-app credentials from Google Cloud Console
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram (Sprint 6) - Instagram Graph API (conta Business/Creator vinculada
# a uma Página do Facebook). Requer também um MediaHoster configurado para
# expor os clipes em uma URL pública (ver publishing_engine/media_hosting.py).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok (Sprint 7) - Content Posting API (Direct Post, PULL_FROM_URL).
# Requer também um MediaHoster configurado (ver publishing_engine/media_hosting.py).
TIKTOK_ACCESS_TOKEN=

# Database (future)
DATABASE_URL=
